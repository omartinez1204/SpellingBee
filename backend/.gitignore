# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Testing / coverage
coverage/

# Environment variables
.env
.env.*
!.env.example

# SQLite database files (RF: no se versiona la base de datos)
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
# Prisma 7 resuelve DATABASE_URL="file:./dev.db" relativo a prisma.config.ts
# (raíz de /backend), no relativo a prisma/schema.prisma como en Prisma <=6.
/dev.db*

# Audios subidos por profesores (RF-11) — contenido de usuario, no código.
/assets/audios/*
!/assets/audios/.gitkeep

# Logs
*.log
npm-debug.log*

# Editor/OS
.DS_Store
.vscode/
.idea/

/src/generated/prisma
