# Copiar a .env y ajustar si hace falta. Ver docs/diseno-tecnico.md §1 (SQLite en modo WAL).
DATABASE_URL="file:./dev.db"

# JWT (T-011, diseno-tecnico.md §1). Generar uno propio, p.ej.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Nunca reusar el valor de ejemplo ni el de otro ambiente.
JWT_SECRET="cambia-esto-por-un-valor-aleatorio-largo"
JWT_EXPIRES_IN="28800"  # segundos (28800 = 8h)
